{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start",
            "program": "${workspaceFolder}/src/app.ts",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {},
            "strictEnv": false,
            "stopOnEntry": false,
            "noDebug": false,
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--env-file-if-exists=${workspaceFolder}/.env",
                "--watch"
            ],
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
